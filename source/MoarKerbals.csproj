<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <KspRoot Condition="'$(KspRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KspRoot>
    <FrameworkPathOverride>$(KspRoot)\KSP_x64_Data\Managed</FrameworkPathOverride>
    <OutputPath>..\artifacts\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);1701;1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(KspRoot)\KSP_x64_Data\Managed\mscorlib.dll" Private="false" />
    <Reference Include="$(KspRoot)\KSP_x64_Data\Managed\System.dll" Private="false" />
    <Reference Include="$(KspRoot)\KSP_x64_Data\Managed\System.Core.dll" Private="false" />
    <Reference Include="$(KspRoot)\KSP_x64_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(KspRoot)\KSP_x64_Data\Managed\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(KspRoot)\KSP_x64_Data\Managed\UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
